{
  "kind": "app",
  "name": "shell",
  "version": "0.1.0",
  "programs": {
    "run": "bin/run-handler.wasm",
    "shell": {
      "code": "shell",
      "modules": {
        "brush": "bin/brush.wasm",
        "coreutils": "bin/coreutils.wasm",
        "find": "bin/find.wasm",
        "xargs": "bin/xargs.wasm",
        "diff": "bin/diff.wasm",
        "cmp": "bin/cmp.wasm",
        "jq": "bin/jq.wasm",
        "which": "bin/which.wasm",
        "grep": "bin/grep.wasm",
        "tree": "bin/tree.wasm",
        "awk": "bin/awk.wasm",
        "sed": "bin/sed.wasm",
        "git": "bin/git.wasm",
        "qjs": "bin/qjs.wasm",
        "python": "bin/python.wasm",
        "node": "bin/qjs.wasm",
        "python3": "bin/python.wasm"
      },
      "support": {
        "python": {
          "mount": "/opt/skein/python",
          "files": { "lib/python314.zip": "lib/python314.zip" },
          "env": { "PYTHONHOME": "/opt/skein/python", "PYTHONDONTWRITEBYTECODE": "1" }
        },
        "python3": {
          "mount": "/opt/skein/python",
          "files": { "lib/python314.zip": "lib/python314.zip" },
          "env": { "PYTHONHOME": "/opt/skein/python", "PYTHONDONTWRITEBYTECODE": "1" }
        }
      }
    }
  },
  "provides": [
    {
      "interface": "shell/1",
      "functions": {
        "run": {
          "writes": true,
          "args": {
            "cmd": "string",
            "tree?": "cid",
            "cwd?": "string",
            "env?": "map"
          },
          "answer": {
            "exitCode": "int",
            "stdout": "string",
            "stderr": "string",
            "tree": "cid"
          }
        }
      }
    }
  ],
  "requires": [],
  "dispatch": [
    {
      "address": "run",
      "sender": "$owner",
      "program": "run"
    }
  ],
  "description": "The shell: `run` (a bash command in the wasm shell over a tree — the body's, else the `main` head's — the answer in the sender's `results` box), from the owner; and the shell program itself, brush with uutils coreutils and the toolset (find, xargs, diff, cmp, jq, which, grep, tree, awk, sed, git, qjs as `node`, python as `python3` with its stdlib), each module a file of this tree. Another app (the chat app's loop) finds the shell program at this app's head `shell/app`."
}
